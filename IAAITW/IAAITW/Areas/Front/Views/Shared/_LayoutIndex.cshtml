<!DOCTYPE html>
<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>國際縱火調查人員協會臺灣分會 - @ViewBag.Title</title>

    <!-- Favicons -->
    <link rel="shortcut icon" href="~/images/favicon.ico" type="image/x-icon" />

    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">

    <!-- Base styles -->
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")

    <!-- 前台css -->
    @Styles.Render("~/Front/css")
</head>
<body>
    <div class="body-inner">
        <!-- Header start -->
        <header id="header" class="header-solid">
            <div class="container">
                <div class="row">
                    <div class="logo col-md-6 col-sm-7 col-xs-12 ">
                        <a href="@Url.Action("Index", "Home", new { area = "Front" })">
                            <img src="~/images/logo.png" alt="國際縱火調查人員協會臺灣分會" title="國際縱火調查人員協會臺灣分會">
                        </a>
                    </div><!-- logo end -->

                    <div class="col-md-6 col-sm-5 col-xs-12 header-right hidden-xs">

                        <ul class="top-info">
                            <li>
                                <div class="info-box">
                                    <a href="https://www.facebook.com/pages/%E5%9C%8B%E9%9A%9B%E7%B8%B1%E7%81%AB%E8%AA%BF%E6%9F%A5%E4%BA%BA%E5%93%A1%E5%8D%94%E6%9C%83%E8%87%BA%E5%8F%B0%E7%81%A3%E5%88%86%E6%9C%83/469105899835805" title="粉絲專頁" target="_blank">
                                        <i class="fa fa-facebook-f">&nbsp;</i>
                                        <div class="info-box-content">
                                            <p class="info-box-title">粉絲專頁</p>
                                        </div>
                                    </a>
                                </div>
                            </li>
                            <li>
                                <div class="info-box">
                                    <a href="english/" title="English">
                                        <i class="fa fa-globe">&nbsp;</i>
                                        <div class="info-box-content">
                                            <p class="info-box-title">English</p>
                                        </div>
                                    </a>
                                </div>
                            </li>
                        </ul>
                    </div><!-- header right end -->
                </div><!-- Row end -->
            </div><!-- Container end -->
        </header><!--/ Header end -->

        <nav class="site-navigation navigation">
            <div class="container">
                <div class="row">
                    <div class="col-sm-12">
                        <div class="site-nav-inner">
                            <button type="button" class="navbar-toggle" data-toggle="collapse" data-target=".navbar-collapse">
                                <span class="sr-only">Toggle navigation</span>
                                <span class="icon-bar"></span>
                                <span class="icon-bar"></span>
                                <span class="icon-bar"></span>
                            </button>

                            <div class="collapse navbar-collapse navbar-responsive-collapse">

                                <ul class="nav navbar-nav">
                                    <li class="dropdown">
                                        <a href="about.html" class="dropdown-toggle" data-toggle="dropdown" title="關於我們">關於我們 <i class="fa fa-angle-down"></i></a>
                                        <ul class="dropdown-menu" role="menu">
                                            <li><a href="about.html">關於我們</a></li>
                                            <li><a href="master.html">組織架構</a></li>
                                            <li><a href="master.html">沿格</a></li>
                                            <li><a href="master.html">配證會員</a></li>
                                            <li><a href="master.html">專家介紹</a></li>
                                        </ul>
                                    </li>
                                    <li class="dropdown">
                                        <a href="news.html" class="dropdown-toggle" data-toggle="dropdown" title="訊息發佈">訊息發佈 <i class="fa fa-angle-down"></i></a>
                                        <ul class="dropdown-menu" role="menu">
                                            <li><a href="news.html">最新消息</a></li>
                                        </ul>
                                    </li>
                                    <li class="dropdown">
                                        <a href="member.html" class="dropdown-toggle" data-toggle="dropdown" title="會員專區">會員專區 <i class="fa fa-angle-down"></i></a>
                                        <ul class="dropdown-menu" role="menu">
                                            <li><a href="member_login.html">討論區</a></li>
                                        </ul>
                                    </li>
                                    <li class="dropdown">
                                        <a href="business.html" class="dropdown-toggle" data-toggle="dropdown" title="協會業務">協會業務 <i class="fa fa-angle-down"></i></a>
                                        <ul class="dropdown-menu" role="menu">
                                            <li><a href="business.html">協會業務</a></li>
                                            <li><a href="business.html">訓練、認證、發照</a></li>
                                            <li><a href="business.html">諮詢、顧問</a></li>
                                            <li><a href="business.html">縱火調查</a></li>
                                        </ul>
                                    </li>
                                    <li class="dropdown">
                                        <a href="knowledge.html" class="dropdown-toggle" data-toggle="dropdown" title="知識庫">知識庫 <i class="fa fa-angle-down"></i></a>
                                        <ul class="dropdown-menu" role="menu">
                                            <li><a href="knowledge.html">知識庫下載</a></li>
                                        </ul>
                                    </li>
                                    <li class="dropdown">
                                        <a href="calendar.html" class="dropdown-toggle" data-toggle="dropdown" title="行事曆">行事曆 <i class="fa fa-angle-down"></i></a>
                                        <ul class="dropdown-menu" role="menu">
                                            <li><a href="calendar.html">協會行事曆</a></li>
                                        </ul>
                                    </li>
                                    <li class="dropdown">
                                        <a href="contact.html" class="dropdown-toggle" data-toggle="dropdown" title="聯絡我們">聯絡我們 <i class="fa fa-angle-down"></i></a>
                                        <ul class="dropdown-menu" role="menu">
                                            <li><a href="contact.html">聯絡我們</a></li>
                                        </ul>
                                    </li>
                                </ul><!--/ Nav ul end -->

                            </div><!--/ Collapse end -->

                        </div><!-- Site Navbar inner end -->

                    </div><!--/ Col end -->
                </div><!--/ Row end -->
            </div><!--/ Container end -->
        </nav><!--/ Navigation end -->
        <!-- Carousel -->
        <div id="main-slide" class="carousel slide" data-ride="carousel">

            <!-- Indicators -->
            <ol class="carousel-indicators visible-lg visible-md">
                <li data-target="#main-slide" data-slide-to="0" class="active"></li>
                <li data-target="#main-slide" data-slide-to="1"></li>
            </ol><!--/ Indicators end-->
            <!-- Carousel inner -->
            <div class="carousel-inner">
                <div class="item active" style="background-image:url(/Images/slider-main-01.jpg)">
                </div><!--/ Carousel item end -->


                <div class="item" style="background-image: url(/Images/slider-main-02.jpg)">
                </div><!--/ Carousel item end -->

            </div><!-- Carousel inner end-->
            <!-- Controllers -->
            <a class="left carousel-control" href="#main-slide" data-slide="prev">
                <span><i class="fa fa-angle-left"></i></span>
            </a>
            <a class="right carousel-control" href="#main-slide" data-slide="next">
                <span><i class="fa fa-angle-right"></i></span>
            </a>

            <span class="down-arrow-transparent"></span>

        </div><!--/ Carousel end -->

        <div class="">
            @RenderBody()
        </div>
        <!-- Footer start -->
        <footer id="footer" class="footer">
            <div class="container">
                <div class="row copyright">
                    <div class="col-xs-12 col-sm-7">
                        <div class="copyright-info">
                            <span>
                                國際縱火調查人員協會臺灣分會版權所有<br>
                                Copyright © 2016 International Association of Arson Investigators Taiwan Chapter. All Rights Reserved.
                            </span>
                        </div>
                    </div>
                    <div class="col-xs-12 col-sm-4 col-md-push-1">
                        <div class="footer-menu">
                            <a class="btn btn-dark" href="@Url.Action("Index", "Declare")" title="財產權宣告">財產權宣告</a>
                        </div>
                    </div>
                </div>
                <!-- Copyright end -->
                <div id="back-to-top" data-spy="affix" data-offset-top="10" class="back-to-top affix">
                    <button class="btn btn-primary" title="Back to Top">
                        <i class="fa fa-angle-double-up"></i>
                    </button>
                </div>
            </div>
            <!--/ Container end -->
        </footer>
        <!-- Footer end -->
        <!-- 通知：Toast Container -->
        <div class="toast-container" style="position: fixed; top: 20px; right: 20px; z-index: 9999;">
            <div id="toastMessage" class="alert" role="alert" style="display:none;">
                <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <span id="toastBody"></span>
            </div>
        </div>
    </div>
        <!-- Javascript Files -->
        @Scripts.Render("~/bundles/jquery")
        @Scripts.Render("~/bundles/bootstrap")
        @Scripts.Render("~/bundles/Front")
        @Scripts.Render("~/bundles/ckeditor")

        <!-- Google Map API -->
        <script src="https://maps.google.com/maps/api/js?sensor=false"></script>

        @* CKEditor *@
        <style>
            .cke_notification_warning {
                display: none !important;
            }
        </style>

        @RenderSection("scripts", required: false)
</body>
</html>
