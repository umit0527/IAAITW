@using MvcPaging
@model MvcPaging.IPagedList<IAAITW.Models.Knowledge>

@{
    ViewBag.Title = "知識庫";
    ViewBag.Breadcrumb = new List<Tuple<string, string>>()
{
     // Tuple<顯示文字, 連結URL>
        new Tuple<string, string>("知識庫",null),
        new Tuple<string, string>("知識庫下載", Url.Action("Index", "Knowledge", new { area = "Front" }))
    };
    // --- 麵包屑設定結束 ---
}

<!-- Banner area end -->
<section id="main-container" class="main-container">
    <div class="container">
        <div class="row">
            <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12">
                <div class="sidebar sidebar-right">
                    <div class="widget">
                        <h2 class="widget-title"><i class="fa fa-folder-open-o">&nbsp;</i>知識庫</h2>
                        <ul class="arrow nav nav-tabs nav-stacked">
                            <li class="active"><a href="@Url.Action("Index", "Knowledge", new { area = "Front" })">知識庫下載</a></li>
                        </ul>
                    </div>
                    <!-- Categories end -->
                </div>
                <!-- Sidebar end -->
            </div>
            <!-- Sidebar Col end -->
            <div class="col-lg-9 col-md-9 col-sm-12 col-xs-12">
                <h2 class="page-title">知識庫下載</h2>
                <hr class="botmargin-min">
                <!-- 內容開始 -->
                <table class="table table-striped career-table download-table">

                    <thead>
                        <tr>
                            <th>日期</th>
                            <th><span class="text-left">標題</span></th>
                            <th>檔案</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="3" style="text-align:center;">目前沒有任何資料</td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        @item.UploadDate.ToString("yyyy-MM-dd")
                                    </td>
                                    <td style="text-align:start;">
                                        @Html.DisplayFor(modelItem => item.Title)
                                    </td>
                                    <td>
                                        <a href="@Url.Action("Download", "Knowledges", new { fileName = item.FilePath })"
                                           class="btn btn-primary btn-sm">
                                            <i class="fa fa-download"></i> 下載
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>

                <div class="paging text-center">
                    <div class="pagination">
                        @Html.Pager(Model.PageSize, Model.PageNumber, Model.TotalItemCount)
                    </div>
                </div>

            </div>
            <!-- Content Col end -->
            <!-- 內容結束 -->
        </div>
        <!-- Main row end -->
    </div>
    <!-- Conatiner end -->
</section>
<!-- Main container end -->
