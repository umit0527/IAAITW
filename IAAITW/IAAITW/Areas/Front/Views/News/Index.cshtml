@using IAAITW.Helper
@using MvcPaging
@model IPagedList<IAAITW.Models.News>


@{
    ViewBag.Title = "訊息發布";
    ViewBag.Breadcrumb = new List<Tuple<string, string>>()
{
     // Tuple<顯示文字, 連結URL>
        new Tuple<string, string>("訊息發布",null),
        new Tuple<string, string>("最新消息", Url.Action("Index", "News", new { area = "Front" }))
    };
    // --- 麵包屑設定結束 ---
}

<section id="main-container" class="main-container">
    <div class="container">
        <div class="row">
            <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12">
                <div class="sidebar sidebar-right">
                    <div class="widget">
                        <h2 class="widget-title"><i class="fa fa-folder-open-o">&nbsp;</i>訊息發佈</h2>
                        <ul class="arrow nav nav-tabs nav-stacked">
                            <li class="active"><a href="#">最新消息</a></li>
                        </ul>
                    </div>
                    <!-- Categories end -->
                </div>
                <!-- Sidebar end -->
            </div>
            <!-- Sidebar Col end -->
            <div class="col-lg-9 col-md-9 col-sm-12 col-xs-12">
                <h2 class="page-title">最新消息</h2>
                <hr class="botmargin-min">
                @foreach (var item in Model)
                {
                    <div class="post">
                        <div class="row">
                            <div class="col-md-3 col-sm-12 col-xs-12">
                                <div class="post-media post-image">
                                    <a href="@Url.Action("Details", "News", new {id = item.Id })">
                                        <img alt="img" src="@Url.Content(item.CoverImage)" class="img-responsive">
                                    </a>
                                </div>
                            </div>
                            <div class="col-md-9 col-sm-12 col-xs-12">
                                <div class="post-body">
                                    <div class="entry-header">
                                        <span class="post-meta-date"><i class="fa fa fa-clock-o"></i> @item.UpdatedDate.ToString("yyyy/MM/dd")</span>
                                        <h3 class="entry-title">
                                            <a href="@Url.Action("Details", "News", new {id = item.Id })">@item.Title</a>
                                        </h3>
                                        <p>@Html.Raw(item.Content.TruncateWithChinese(68))</p>
                                    </div>
                                    <!-- header end -->
                                    <div class="post-footer">
                                        <a href="@Url.Action("Details", "News", new {id = item.Id })" class="btn btn-primary">more</a>
                                    </div>
                                </div>
                                <!-- post-body end -->
                            </div>
                        </div>
                    </div>
                }

                <div class="pagin text-center">
                    <div class="pagination">
                        @Html.Pager(Model.PageSize, Model.PageNumber, Model.TotalItemCount)
                    </div>
                </div>
            </div>
            <!-- Content Col end -->
        </div>
        <!-- Main row end -->
    </div>
    <!-- Conatiner end -->
</section>