@model IEnumerable<IAAITW.Models.News>

@{
    ViewBag.Title = "訊息發布";
    ViewBag.Breadcrumb = new List<Tuple<string, string>>()
{
     // Tuple<顯示文字, 連結URL>
        new Tuple<string, string>("訊息發布",null),
        new Tuple<string, string>("最新消息", Url.Action("Index", "News", new { area = "Front" }))
    };
    // --- 麵包屑設定結束 ---
}

<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.LastUpdater.Account)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Publisher.Account)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Title)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Content)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.CoverImage)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.CreatedDate)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.UpdatedDate)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.IsPinned)
        </th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.LastUpdater.Account)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Publisher.Account)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Title)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Content)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.CoverImage)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.CreatedDate)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.UpdatedDate)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.IsPinned)
        </td>
        <td>
            @Html.ActionLink("Edit", "Edit", new { id=item.Id }) |
            @Html.ActionLink("Details", "Details", new { id=item.Id }) |
            @Html.ActionLink("Delete", "Delete", new { id=item.Id })
        </td>
    </tr>
}

</table>
