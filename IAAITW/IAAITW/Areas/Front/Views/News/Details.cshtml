@model IAAITW.Models.News

@{
    ViewBag.Title = "訊息發布";
    ViewBag.Breadcrumb = new List<Tuple<string, string>>()
{
     // Tuple<顯示文字, 連結URL>
        new Tuple<string, string>("訊息發布",null),
        new Tuple<string, string>("訊息發布", Url.Action("Details", "News", new { id=Model.Id }))
    };
    // --- 麵包屑設定結束 ---  
}

<!-- Banner area end -->
<section id="main-container" class="main-container">
    <div class="container" style="padding-bottom:50px">
        <div class="row">
            <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12">
                <div class="sidebar sidebar-right">
                    <div class="widget">
                        <h2 class="widget-title"><i class="fa fa-folder-open-o">&nbsp;</i>訊息發布</h2>
                        <ul class="arrow nav nav-tabs nav-stacked">
                            <li class="active"><a href="@Url.Action("Index", "News")">最新消息</a></li>
                        </ul>
                    </div>
                    <!-- Categories end -->
                </div>
                <!-- Sidebar end -->
            </div>
            <!-- Sidebar Col end -->
            <div class="col-lg-9 col-md-9 col-sm-12 col-xs-12">
                <h2 class="page-title">訊息發布</h2>
                <hr class="botmargin-min">
                <!-- 內容開始 -->
                <div class="post-content">
                    <div class="post-body">

                        @* 標題 *@
                        <div class="entry-header">
                            <span class="post-meta-date"><i class="fa fa fa-clock-o"></i> @Model.UpdatedDate.ToString("yyyy/MM/dd")</span>
                            <h2 class="entry-title">@Model.Title</h2>
                        </div>

                        @* 封面 *@
                        <div class="post-media post-image">
                            <img src="@Url.Content(Model.CoverImage)" class="img-responsive" alt="">
                        </div>

                        @* 內容 *@
                        <div class="entry-content topmargin-min">
                            @Html.Raw(Model.Content)
                        </div>

                        @*分頁*@
                        <div class="tags-area clearfix">
                            <div class="post-footer  pull-left">
                                <p>
                                    @Html.ActionLink("返回列表", "Index", null, new { @class = "btn btn-primary" })
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Content Col end -->
            <!-- 內容結束 -->
        </div>
        <!-- Main row end -->
    </div>
    <!-- Conatiner end -->

</section>
<!-- Main container end -->
