@using MvcPaging
@model IAAITW.Models.DiscussionContentViewModel

@{
    ViewBag.Title = "Details";
    ViewBag.Breadcrumb = new List<Tuple<string, string>>()
{
     // Tuple<顯示文字, 連結URL>
        new Tuple<string, string>("會員專區",null),
        new Tuple<string, string>("討論區", Url.Action("Index", "MemberDiscussion", new { area = "Front" }))
    };
    // --- 麵包屑設定結束 ---
}

<div>
    @Html.AntiForgeryToken()
    <section id="main-container" class="main-container">
        <div class="container">
            <div class="row">

                <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12">

                    <div class="sidebar sidebar-right">

                        <div class="widget">
                            <h2 class="widget-title"><i class="fa fa-folder-open-o">&nbsp;</i>會員專區</h2>
                            <ul class="arrow nav nav-tabs nav-stacked">
                                <li class="active"><a href="@Url.Action("Index", "MemberDiscussion", new { area = "Front" })">討論區</a></li>
                                <li><a href="@Url.Action("Edit", "Member", new { area = "Front" })">修改個人資料</a></li>
                                <li><a href="@Url.Action("Logout", "Member", new { area = "Front" })">登出</a></li>
                            </ul>
                        </div>

                        <!-- Categories end -->

                    </div><!-- Sidebar end -->
                </div><!-- Sidebar Col end -->

                <div class="col-lg-9 col-md-9 col-sm-12 col-xs-12">
                    <div>
                        <h2 class="page-title">討論區</h2>
                        <hr class="botmargin-min">
                        <!-- 內容開始 -->

                        <style>
                            .entry-header {
                                background: #3c73b0;
                                color: white;
                                padding: 10px 30px;
                            }

                                .entry-header .entry-title {
                                    color: white;
                                }

                            .entry-title {
                            }

                            .post-meta-date {
                            }

                            .post-content {
                                border: whitesmoke 1px solid;
                                margin-bottom: 20px;
                                box-shadow: rgba(210,210,210,.1) 2px 2px 20px;
                            }

                            .entry-content {
                            }

                            .post {
                                border: whitesmoke 1px solid;
                                padding: 0;
                            }

                            .postInfo {
                                padding: 10px 20px;
                                background: #eee;
                                text-align: right;
                            }

                            .respon {
                                margin: 20px auto;
                                display: inline-block;
                                padding: 3px 8px;
                                background: #b2b2b2;
                                color: white;
                                border-radius: 2px;
                            }

                            .post-body {
                                background: #FCFCFC;
                                padding: 30px;
                                box-shadow: rgba(210,210,210,.1) 2px 2px 20px;
                            }

                            .clear {
                                clear: both;
                            }

                            .postMan {
                                font-size: 16px;
                            }
                        </style>

                        @*主文章*@
                        <div class="post-content">
                            <div class="entry-header">
                                <h2 class="entry-title">
                                    @Html.DisplayFor(m => m.Title)
                                </h2>
                                <div>
                                    <span class="postMan"> 發表人：@Html.DisplayFor(m => m.PosterName)</span>

                                </div>
                            </div><!-- header end -->
                            <div class="postInfo">
                                <span class="post-meta-date"><i class="fa fa fa-clock-o"></i> @Model.CreatedDate.ToString("yyyy/MM/dd")</span>
                            </div>
                            <div class="post-body">
                                <div class="entry-content topmargin-min">
                                    <p>@Html.Raw(Model.Content)</p>
                                </div>
                                <div class="tags-area clearfix"></div>
                            </div>
                        </div><!-- post-body end -->
                        @*主文章編輯/刪除*@
                        @if (Model.PosterId == ViewBag.LoginUser)
                        {
                            <div class="" style="text-align:right;">
                                @Html.ActionLink("編 輯", "EditPost", new { id = Model.PostId }, new { @class = "respon", style = "padding:6px 12px;margin:0px;height:33.6px;" })
                                <input type="submit" value="刪 除" data-id="@Model.PostId" class="btn btn-warning delete-post-btn ms-1" style="border-radius: 2px; margin-bottom:4px; margin-left:5px;" />
                            </div>
                        }

                        <p>
                            @Html.ActionLink("回應文章", "CreateRe", new { id = Model.PostId }, new { @class = "respon" })
                        </p>

                        <div class="clear align-items-center"></div>

                        @*回覆區*@
                        @if (Model.Replies != null && Model.Replies.Any())
                        {
                            foreach (var reply in Model.Replies.ToList())
                            {
                                <div class="post">
                                    <div class="entry-header">
                                        回應：@reply.ReplierName
                                    </div>
                                    <div class="postInfo">
                                        <span>@reply.ReplyDate.ToString("yyyy/MM/dd")</span>
                                    </div>
                                    <div class="post-body">
                                        <p>@Html.Raw(reply.ReplyContent)</p>
                                    </div>
                                </div>

                                //回覆者的編輯與刪除
                                if (reply.ReplierId == ViewBag.LoginUser)
                                {
                                    <div class="" style="text-align:end; margin-bottom:30px;">
                                        @Html.ActionLink("編 輯", "EditReply", new { id = reply.Id }, new { @class = "respon", style = "padding:6px 12px;margin:0px;height:33.6px;" })
                                        <input type="submit" value="刪 除" data-id="@reply.Id" class="btn btn-warning delete-reply-btn ms-1" style="border-radius: 2px; margin-bottom:4px; margin-left:5px;" />
                                    </div>
                                }
                            }
                            <div class="paging text-center">
                                <div class="pagination">
                                    @Html.Pager(Model.Replies.PageSize, Model.Replies.PageNumber, Model.Replies.TotalItemCount)
                                </div>
                            </div>
                        }
                        else
                        {
                            <p>目前尚無回覆。</p>
                        }
                        <!-- 內容結束 -->

                    </div><!-- Content Col end -->

                    <div class="post-footer pull-left">
                        @Html.ActionLink("返回列表", "Index", null, new { @class = "btn btn-primary" })
                    </div>
                </div>
            </div><!-- Main row end -->

        </div><!-- Conatiner end -->
    </section><!-- Main container end -->
</div>


@section scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(function () {
            $('.delete-post-btn').on('click', function () {
                if (!confirm('確定要刪除這筆資料嗎？')) return;

                var id = $(this).data('id');
                var row = $('#row-' + id);
                // 讀取 AntiForgery token（由 @Html.AntiForgeryToken() 產生）
                var token = $('input[name="__RequestVerificationToken"]').val();

                $.ajax({
                    url: '@Url.Action("DeletePost", "MemberDiscussion", new { area = "Front" })',
                    type: 'POST',
                    dataType: 'json',
                    data: {
                        id: id,
                        __RequestVerificationToken: token
                    },
                    success: function (res) {
                        if (res && res.success) {
                            alert(res.message || '刪除成功！');
                            if (res.redirectUrl) {
                                window.location.href = res.redirectUrl;
                            }
                        } else {
                            var msg = (res && res.message) ? res.message : '刪除失敗';
                            alert('刪除失敗: ' + msg);
                        }
                    },
                    error: function (xhr, status, err) {
                        // 更完整的錯誤資訊，有助 debug
                        console.error('刪除錯誤', status, err, xhr.responseText);
                        alert('刪除時發生錯誤，請稍後再試。');
                    }
                });
            });

            $('.delete-reply-btn').on('click', function () {
                if (!confirm('確定要刪除回覆嗎？')) return;

                var id = $(this).data('id');
                var token = $('input[name="__RequestVerificationToken"]').val();

                $.ajax({
                    url: '@Url.Action("DeleteReply", "MemberDiscussion", new { area = "Front" })',
                    type: 'POST',
                    data: {
                        id: id,
                        __RequestVerificationToken: token
                    },
                    success: function (res) {
                        if (res.success) {
                            alert('刪除成功');
                            window.location.href = res.redirectUrl;
                        } else {
                            alert('刪除失敗：' + res.message);
                        }
                    }
                });
            });
        });
    </script>
}