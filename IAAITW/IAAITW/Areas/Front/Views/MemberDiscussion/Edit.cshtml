@model IAAITW.Models.MemberDiscussionPost

@{
    ViewBag.Title = "Edit";
}

<h2>Edit</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @Html.HiddenFor(m=>m.Id)
        <section id="main-container" class="main-container">
            <div class="container">
                <div class="row">

                    <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12">

                        <div class="sidebar sidebar-right">

                            <div class="widget">
                                <h2 class="widget-title"><i class="fa fa-folder-open-o">&nbsp;</i>會員專區</h2>
                                <ul class="arrow nav nav-tabs nav-stacked">
                                    <li class="active"><a href="/Download/Create">討論區</a></li>
                                    <li><a href="/Member/Edit">修改個人資料</a></li>
                                    <li><a href="/Member/LogOff">登出</a></li>
                                </ul>
                            </div>

                            <!-- Categories end -->

                        </div><!-- Sidebar end -->
                    </div><!-- Sidebar Col end -->

                    <div class="col-lg-9 col-md-9 col-sm-12 col-xs-12">

                        <h2 class="page-title">討論區</h2>
                        <hr class="botmargin-min">
                        <!-- 內容開始 -->

                        <div class="form-group">
                            @Html.LabelFor(model => model.Title, htmlAttributes: new { @class = "control-label col-md-2" })
                            <div class="col-md-10">
                                @Html.EditorFor(model => model.Title, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.Title, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">

                            <div class="col-md-12">
                                @Html.TextAreaFor(m => m.Content, new { @class = "form-control", id = "editor" })
                                @Html.ValidationMessageFor(model => model.Content, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="col-md-offset-2 col-md-10">
                                <input type="submit" value="發 表" class="btn btn-primary solid blank" />
                            </div>
                        </div>
                        <!-- 內容結束 -->
                    </div><!-- Content Col end -->


                </div><!-- Main row end -->

            </div><!-- Conatiner end -->
        </section><!-- Main container end -->
    </div>
}


@section Scripts {
    @* 文字編輯器 *@
    <script>
        $(document).ready(function () {
            if (typeof CKEDITOR !== 'undefined') {
                CKEDITOR.replace('editor', {
                    height: 500,
                    language: 'zh'
                });
            }
            else
            {
                console.error('CKEditor is not loaded!');
            }

            // 顯示成功訊息並跳轉
            @if (TempData["SuccessMessage"] != null)
            {
                <text>
                    setTimeout(function () {
                        alert("@TempData["SuccessMessage"]");
                        setTimeout(function () {
                            window.location.href = "@ViewBag.RedirectUrl";
                        }, 800); // 再延遲 0.8 秒跳轉
                    }, 500); // 先等 CKEditor 載完 0.5 秒
                </text>
            }

            // 顯示錯誤訊息
            @if (TempData["ErrorMessage"] != null)
            {
                <text>
                    alert("@TempData["ErrorMessage"]");
                </text>
            }
        });
    </script>
}

