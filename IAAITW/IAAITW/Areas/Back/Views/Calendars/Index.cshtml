@{
    ViewBag.Title = "協會行事曆";
}

<div class="">
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="row">
                <div class="col-12">
                    <h3 class="font-weight-bold">協會行事曆</h3> 
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12 grid-margin stretch-card">
            <div class="card">
                
                <div class="card-body">
                    <p class="card-title mb-0">協會行事曆</p>
                    <hr />
                    <div class="calendar-container">
                        <div class="d-flex justify-content-center">
                            <iframe src="https://calendar.google.com/calendar/embed?height=600&amp;wkst=1&amp;bgcolor=%23FFFFFF&amp;src=iaaitw119%40gmail.com&amp;color=%2329527A&amp;src=zh.taiwan%23holiday%40group.v.calendar.google.com&amp;color=%23AB8B00&amp;ctz=Asia%2FTaipei"
                                    style="border-width:0; border-radius: 4px;"
                                    width="100%"
                                    height="600"
                                    frameborder="0"
                                    scrolling="no">
                            </iframe>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .calendar-container {
        max-width: 1000px;
        margin: 0 auto;
        overflow-x: auto;
    }

    @@media (max-width: 768px) {
        .calendar-container iframe {
            width: 100% !important;
            height: 400px !important;
        }
    }
</style>