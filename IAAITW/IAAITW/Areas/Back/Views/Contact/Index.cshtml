@model MvcPaging.IPagedList<IAAITW.Models.Contact>

@{
    ViewBag.Title = "聯絡我們";
}

<div>
    <h2>聯絡我們</h2>
    <table class="table">
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.FirstOrDefault().Title)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FirstOrDefault().Content)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FirstOrDefault().Name)
            </th>
            @*<th>
                @Html.DisplayNameFor(model => model.FirstOrDefault().Gender)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FirstOrDefault().PhoneNumber)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FirstOrDefault().Email)
            </th>*@
            <th>
                @Html.DisplayNameFor(model => model.FirstOrDefault().SentDate)
            </th>
            <th></th>
        </tr>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="12" style="text-align:center;">目前沒有任何資料</td>
            </tr>
        }
        else
        {
            foreach (var item in Model)
            {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.Title)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Content)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Name)
        </td>
        @*<td>
            @Html.DisplayFor(modelItem => item.Gender)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.PhoneNumber)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Email)
        </td>*@
        <td>
            @item.SentDate.ToString("yyyy/MM/dd HH:mm")
        </td>
        <td>
            @Html.ActionLink("詳 情", "Details", new { id = item.Id }) 
        </td>
    </tr>
            }
        }
    </table>
</div>