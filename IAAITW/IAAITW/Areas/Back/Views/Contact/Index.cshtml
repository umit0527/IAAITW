@using MvcPaging
@using IAAITW.Helper
@model MvcPaging.IPagedList<IAAITW.Models.Contact>

@{
    ViewBag.Title = "聯絡我們";
}

<div class="">

    <div class="row mb-4">
        <div class="col-12 col-xl-8  mb-xl-0">
            <h3 class="font-weight-bold">聯絡我們</h3>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12 grid-margin stretch-card">
            <div class="card">
                <div class="card-body">
                    <p class="card-title mb-0">聯絡資料列表</p>
                    @if (!Model.Any())
                    {
                        <div class="alert alert-info mt-3" role="alert">
                            目前沒有任何資料
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive mt-3">
                            <table class="table table-striped table-borderless">
                                <thead>
                                    <tr>
                                        <th>主 旨</th>
                                        <th>內 容</th>
                                        <th>聯絡人名稱</th>
                                        <th>提交日期</th>
                                        <th>操 作</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr id="row-@item.Id">
                                            <td>
                                                @{
                                                    var shortTitle = item.Title.TruncateWithChinese(40) + "...";
                                                }
                                                <span title="@item.Title">@shortTitle</span>
                                            </td>
                                            <td>
                                                @{
                                                    var shortContent =  item.Content.TruncateWithChinese(46) + "...";
                                                }
                                                <span title="@item.Content">@shortContent</span>
                                            </td>
                                            <td>
                                                @item.Name
                                            </td>
                                            <td>
                                                @item.SentDate.ToString("yyyy/MM/dd HH:mm")
                                            </td>
                                            <td>
                                                <div>
                                                    @Html.ActionLink("詳 情", "Details", new { id = item.Id }, new { @class = "btn btn-outline-info btn-sm" })
                                                    <button class="delete-btn btn btn-outline-danger btn-sm" data-id="@item.Id" type="button">刪 除</button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@if (Model.Any())
{
    <div class="row">
        <div class="col-md-12 grid-margin">
            <div class="d-flex justify-content-center">
                <div class="pager">
                    @Html.Pager(Model.PageSize, Model.PageNumber, Model.TotalItemCount)
                </div>
            </div>
        </div>
    </div>
}

@section scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(function () {
            $('.delete-btn').on('click', function () {
                if (!confirm('確定要刪除這筆資料嗎？')) return;

                var id = $(this).data('id');
                var row = $('#row-' + id);
                var token = $('input[name="__RequestVerificationToken"]').val();

                $.ajax({
                    url: '@Url.Action("DeleteConfirmed", "Contact", new { area = "Back" })',
                    type: 'POST',
                    dataType: 'json',
                    data: {
                        id: id,
                        __RequestVerificationToken: token
                    },
                    success: function (res) {
                        if (res && res.success) {
                            row.fadeOut(300, function () { $(this).remove(); });
                            alert('刪除成功！');
                            location.reload();
                        } else {
                            var msg = (res && res.message) ? res.message : '刪除失敗';
                            alert('刪除失敗: ' + msg);
                        }
                    },
                    error: function (xhr, status, err) {
                        console.error('刪除錯誤', status, err, xhr.responseText);
                        alert('刪除時發生錯誤，請稍後再試。');
                    }
                });
            });
        });
    </script>
}