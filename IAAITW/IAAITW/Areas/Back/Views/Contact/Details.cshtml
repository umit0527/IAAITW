@model IAAITW.Models.Contact

@{
    ViewBag.Title = "詳情 | 聯絡我們";
}

<div class="">
    <div class="row mb-4">
        <div class="col-12">
            <h3 class="font-weight-bold">聯絡我們</h3>
        </div>
    </div>


    @if (ViewBag.HasData == true)
    {
        <div class="row">
            <div class="col-md-12 grid-margin stretch-card">
                <div class="card">
                    <div class="card-body">
                        <h4 class="card-title">詳 情</h4>
                        <hr />
                        <div class="row mb-4">
                            <!-- 左邊欄 -->
                            <div class="col-md-7">
                                <!-- 主旨 -->
                                <div class="mb-3">
                                    <label class="form-label fw-bold">詢問標題</label>
                                    <div class="form-control" style="background-color: #f8f9fa;">@Model.Title</div>
                                </div>

                                <!-- 內容 -->
                                <div class="mb-3">
                                    <label class="form-label fw-bold">詢問內容</label>
                                    <div class="form-control" style="background-color: #f8f9fa; ">
                                        @Model.Content
                                    </div>
                                </div>
                            </div>

                            <!-- 右邊欄 -->
                            <div class="col-md-5">
                                <div class="row">
                                    <div class="col-md-4">
                                        <!-- 聯絡人名稱 -->
                                        <div class="mb-3">
                                            <label class="form-label fw-bold">聯絡人名稱</label>
                                            <p class="form-control-plaintext">@Model.Name</p>
                                        </div>
                                    </div>

                                    <div class="col-md-2">
                                        <!-- 性別 -->
                                        <div class="mb-3">
                                            <label class="form-label fw-bold">性 別</label>
                                            <p class="form-control-plaintext">@Model.Gender</p>
                                        </div>
                                    </div>

                                    <div class="col-md-4">
                                        <!-- 提交日期 -->
                                        <div class="mb-3">
                                            <label class="form-label fw-bold">寄出日期</label>
                                            <p class="form-control-plaintext">@Model.SentDate.ToString("yyyy/MM/dd HH:mm")</p>
                                        </div>
                                    </div>
                                </div>
                                

                                <div class="row">
                                    <!-- 電話號碼 -->
                                    <div class="col-md-4">
                                        <div class="mb-3">
                                            <label class="form-label fw-bold">電話號碼</label>
                                            <p class="form-control-plaintext">
                                                <a href="tel:@Model.PhoneNumber">@Model.PhoneNumber</a>
                                            </p>
                                        </div>
                                    </div>

                                    <!-- 電子郵件 -->
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label class="form-label fw-bold">電子郵件</label>
                                            <p class="form-control-plaintext">
                                                <a href="mailto:@Model.Email">@Model.Email</a>
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-md-12 grid-margin stretch-card">
                <div class="card">
                    <div class="card-body">
                        <div class="alert alert-warning" role="alert">
                            <i class="mdi mdi-alert-circle me-2"></i>目前沒有資料
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    <!-- 按鈕 -->
    <div class="row">
        <div style="width:120px;">
            <div class="d-flex flex-column gap-2">
                <a class="btn btn-secondary" href="@Url.Action("Index", "Contact", new { area = "Back" })">返 回</a>
            </div>
        </div>
    </div>
</div>