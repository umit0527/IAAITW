@using IAAITW.Helper;
@using MvcPaging
@model MvcPaging.IPagedList<IAAITW.Models.News>

@{
    ViewBag.Title = "News";
}

<div>
    <h2>消息</h2>

    <p>
        @Html.ActionLink("Create New", "Create")
    </p>
    <table class="table">
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.FirstOrDefault().IsPinned)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FirstOrDefault().CoverImage)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FirstOrDefault().Title)
            </th>
            <th>
                發布人員
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FirstOrDefault().CreatedDate)
            </th>
            <th>
                最後更新人員
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FirstOrDefault().UpdatedDate)
            </th>
            <th></th>
        </tr>

        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.IsPinned)
                </td>
                <td>
                    <img src="@Url.Content(item.CoverImage)" style="width:80px; height:auto; border-radius:0;" />
                </td>
                <td>
                    @{
                        // 截斷
                        var shortTitle = item.Title.TruncateWithChinese(34);
                    }
                    @shortTitle
                </td>
                <td>
                    @{
                        // 截斷
                        var shortPublisher = item.Publisher.Name.TruncateWithChinese(6);
                    }
                    @shortPublisher
                </td>
                <td>
                    @item.CreatedDate.ToString("yyyy/MM/dd HH:mm")
                </td>
                <td>
                    @{
                        // 截斷
                        var shortUpdater = item.LastUpdater.Name.TruncateWithChinese(6);
                    }
                    @shortUpdater
                </td>
                <td>
                    @item.UpdatedDate.ToString("yyyy/MM/dd HH:mm")
                </td>
                <td>
                    @Html.ActionLink("Edit", "Edit", new { id = item.Id }) |
                    @Html.ActionLink("Details", "Details", new { id = item.Id }) |
                    @Html.ActionLink("Delete", "Delete", new { id = item.Id })
                </td>
            </tr>
        }
    </table>
</div>

<div class="pager text-center pt-5">
    @Html.Pager(Model.PageSize, Model.PageNumber, Model.TotalItemCount)
</div>