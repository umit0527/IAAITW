@using IAAITW.Helper;
@using MvcPaging
@model MvcPaging.IPagedList<IAAITW.Models.News>

@{
    ViewBag.Title = "訊息發布";
}

<div class="">
    <div class="row mb-3">
        <div class="col-md-12">
            <div class="row">
                <div class="col-12 col-xl-8 mb-4 mb-xl-0">
                    <h3 class="font-weight-bold">訊息發布</h3>
                </div>
                <div class="col-12 col-xl-4">
                    <div class="justify-content-end d-flex">
                        @Html.ActionLink("新 增", "Create", new { }, new { @class = "btn btn-primary" })
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12 grid-margin stretch-card">
            <div class="card">
                <div class="card-body">
                    <p class="card-title mb-0">訊息列表</p>
                    @if (!Model.Any())
                    {
                        <div class="alert alert-info mt-3" role="alert">
                            目前沒有任何資料
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive mt-3">
                            <table class="table table-striped table-borderless">
                                @Html.AntiForgeryToken()
                                <thead>
                                    <tr>
                                        <th>置頂</th>
                                        <th>封面</th>
                                        <th>標題</th>
                                        <th>發布人員</th>
                                        <th>建立日期</th>
                                        <th>最後更新人員</th>
                                        <th>更新日期</th>
                                        <th>操作</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr id="row-@item.Id">
                                            <td>
                                                <div class="form-switch">
                                                    @Html.EditorFor(model => item.IsPinned, new { htmlAttributes = new { @class = "form-check-input", disabled = "disabled" } })

                                                </div>
                                            </td>
                                            <td>
                                                <img src="@Url.Content(item.CoverImage)" style="width: 60px; height: auto; border-radius: 4px;"/>
                                            </td>
                                            <td>
                                                @{
                                                    var shortTitle = item.Title.TruncateWithChinese(34);
                                                }
                                                <span title="@item.Title">@shortTitle</span>
                                            </td>
                                            <td>
                                                @{
                                                    var shortPublisher = item.Publisher.Name.TruncateWithChinese(6);
                                                }
                                                @shortPublisher
                                            </td>
                                            <td>
                                                @item.CreatedDate.ToString("yyyy/MM/dd HH:mm")
                                            </td>
                                            <td>
                                                @{
                                                    var shortUpdater = item.LastUpdater.Name.TruncateWithChinese(6);
                                                }
                                                @shortUpdater
                                            </td>
                                            <td>
                                                @item.UpdatedDate.ToString("yyyy/MM/dd HH:mm")
                                            </td>
                                            <td>
                                                <div>
                                                    @Html.ActionLink("編 輯", "Edit", new { id = item.Id }, new { @class = "btn btn-outline-info btn-sm" })
                                                    @Html.ActionLink("詳 情", "Details", new { id = item.Id }, new { @class = "btn btn-outline-success btn-sm" })
                                                    <button class="delete-btn btn btn-outline-danger btn-sm" data-id="@item.Id" type="button">刪 除</button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@if (Model.Any())
{
    <div class="row">
        <div class="col-md-12 grid-margin">
            <div class="d-flex justify-content-center">
                <div class="pager">
                    @Html.Pager(Model.PageSize, Model.PageNumber, Model.TotalItemCount)
                </div>
            </div>
        </div>
    </div>
}

@section scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(function () {
            $('.delete-btn').on('click', function () {
                if (!confirm('確定要刪除這筆資料嗎？')) return;

                var id = $(this).data('id');
                var row = $('#row-' + id);
                var token = $('input[name="__RequestVerificationToken"]').val();

                $.ajax({
                    url: '@Url.Action("DeleteConfirmed", "News", new { area = "Back" })',
                    type: 'POST',
                    dataType: 'json',
                    data: {
                        id: id,
                        __RequestVerificationToken: token
                    },
                    success: function (res) {
                        if (res && res.success) {
                            row.fadeOut(300, function () { $(this).remove(); });
                            alert('刪除成功！');
                            location.reload();
                        } else {
                            var msg = (res && res.message) ? res.message : '刪除失敗';
                            alert('刪除失敗: ' + msg);
                        }
                    },
                    error: function (xhr, status, err) {
                        console.error('刪除錯誤', status, err, xhr.responseText);
                        alert('刪除時發生錯誤，請稍後再試。');
                    }
                });
            });
        });

        @if (TempData["SuccessMessage"] != null)
        {
            <text>
                setTimeout(function () {
                    alert("@TempData["SuccessMessage"]");
                    setTimeout(function () {
                        window.location.href = "@ViewBag.RedirectUrl";
                    }, 800);
                }, 500);
            </text>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <text>
                alert("@TempData["ErrorMessage"]");
            </text>
        }
    </script>
}