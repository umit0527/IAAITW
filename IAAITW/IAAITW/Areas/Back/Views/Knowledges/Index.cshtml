@model IEnumerable<IAAITW.Models.Knowledge>

@{
    ViewBag.Title = "Knowledge";
}

<h2>知識庫下載</h2>

<p>
    @Html.ActionLink("新  增", "Create")
</p>

@Html.AntiForgeryToken()
<table class="table">
    <tr>

        <th>
            @Html.DisplayNameFor(model => model.Title)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Description)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.FilePath)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.UploadDate)
        </th>
        <th>
            上傳人員
        </th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Title)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Description)
            </td>
            <td>
                @Path.GetFileName(item.FilePath)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.UploadDate, "{yyyy/MM/dd HH:mm}")
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Admin.Name)
            </td>
            <td>
                @Html.ActionLink("Edit", "Edit", new { id = item.Id }) |
                @*@Html.ActionLink("Details", "Details", new { id = item.Id }) |*@
                @*@Html.ActionLink("Delete", "Delete", new { id = item.Id })*@
                <button class="" data-id="@item.Id">刪除</button>
            </td>
        </tr>
    }

</table>

@section scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(function () {
            $('.delete-btn').on('click', function () {
                if (!confirm('確定要刪除這筆資料嗎？')) return;

                var id = $(this).data('id');
                var row = $('#row-' + id);
                // 讀取 AntiForgery token（由 @Html.AntiForgeryToken() 產生）
                var token = $('input[name="__RequestVerificationToken"]').val();

                $.ajax({
                    url: '@Url.Action("DeleteConfirmed", "Knowledges", new { area = "Back" })', // 若 Controller 不在 Area Back，移除 new { area = "Back" }
                    type: 'POST',
                    dataType: 'json',
                    data: {
                        id: id,
                        __RequestVerificationToken: token
                    },
                    success: function (res) {
                        if (res && res.success) {
                            row.fadeOut(300, function () { $(this).remove(); });
                            // 可改成更漂亮的提示元件（toast）
                            alert('刪除成功！');
                            location.reload();
                        } else {
                            var msg = (res && res.message) ? res.message : '刪除失敗';
                            alert('刪除失敗: ' + msg);
                        }
                    },
                    error: function (xhr, status, err) {
                        // 更完整的錯誤資訊，有助 debug
                        console.error('刪除錯誤', status, err, xhr.responseText);
                        alert('刪除時發生錯誤，請稍後再試。');
                    }
                });
            });
        });
    </script>
}
