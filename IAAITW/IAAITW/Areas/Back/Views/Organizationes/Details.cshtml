@model IAAITW.Models.Organization

@{
    ViewBag.Title = "組織架構";
}

<div class="row">
    <h3 class="mb-4">關於我們</h3>
    <div class="col-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">組織架構</h4>
                <hr />
                @Html.AntiForgeryToken()

                @if (ViewBag.HasData == false)
                {
                    <p>
                        <a class="btn btn-primary" href="@Url.Action("Create", "Organizationes", new { area = "Back" })">新 增</a>
                    </p>
                }

                @if (ViewBag.HasData == true)
                {
                    <div class="row">
                        <!-- 左欄：內容（較寬） -->
                        <div class="col-lg-8 col-md-7 col-12 mb-3">
                            <h6 class="text-muted">內容</h6>
                            <div class="border p-3 form-control" style="max-width:100%; height:100%;">
                                @Html.Raw(Model.Content)
                            </div>
                        </div>

                        <!-- 右欄：其他欄位與操作（較窄） -->
                        <div class="col-lg-4 col-md-5 col-12">
                            <div class="mb-3">
                                <h6 class="text-muted">詳細資訊</h6>
                                <table class="table mb-3">
                                    <tbody>
                                        <tr>
                                            <th scope="row" class="col-sm-5">建立時間</th>
                                            <td class="col-sm-7">@Model.CreatedDate.ToString("yyyy/MM/dd HH:mm")</td>
                                        </tr>

                                        <tr>
                                            <th scope="row" class="col-sm-5">建立人員</th>
                                            <td class="col-sm-7">@Html.DisplayFor(model => model.Admin.Name)</td>
                                        </tr>

                                        <tr>
                                            <th scope="row" class="col-sm-5">最後更新</th>
                                            <td class="col-sm-7">@Model.UpdatedDate.ToString("yyyy/MM/dd HH:mm")</td>
                                        </tr>

                                        <tr>
                                            <th scope="row" class="col-sm-5">最後更新人員</th>
                                            <td class="col-sm-7">@Html.DisplayFor(model => model.UpdatedAdmin.Name)</td>
                                        </tr>
                                    </tbody>
                                </table>

                                <div class="d-flex gap-2">
                                    <a class="btn btn-sm btn-outline-info" href="@Url.Action("Edit", "Organizationes", new { area = "Back", id = Model.Id })">編 輯</a>
                                    <button class="btn btn-sm btn-outline-danger delete-btn" data-id="@Model.Id">刪 除</button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <p>目前沒有資料</p>
                }
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(function () {
            $('.delete-btn').on('click', function () {
                if (!confirm('確定要刪除這筆資料嗎？')) return;

                var id = $(this).data('id');
                var token = $('input[name="__RequestVerificationToken"]').val();

                $.ajax({
                    url: '@Url.Action("DeleteConfirmed", "Organizationes", new { area = "Back" })',
                    type: 'POST',
                    dataType: 'json',
                    data: {
                        id: id,
                        __RequestVerificationToken: token
                    },
                    success: function (res) {
                        if (res && res.success) {
                            alert('刪除成功！');
                            location.reload();
                        } else {
                            var msg = (res && res.message) ? res.message : '刪除失敗';
                            alert('刪除失敗: ' + msg);
                        }
                    },
                    error: function (xhr, status, err) {
                        console.error('刪除錯誤', status, err, xhr.responseText);
                        alert('刪除時發生錯誤，請稍後再試。');
                    }
                });
            });
        });
    </script>
}