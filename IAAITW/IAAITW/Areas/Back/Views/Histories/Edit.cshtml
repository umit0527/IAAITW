@model IAAITW.Models.History

@{
    ViewBag.Title = "編輯 | 沿革";
}

<div class="row">
    <h3 class=" mb-4">沿革</h3>
    <div class="col-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">編 輯</h4>
                <hr />
                @using (Html.BeginForm("Edit", "Histories", new { area = "Back" }, FormMethod.Post, new { @class = "form-horizontal" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    @Html.HiddenFor(model => model.Id)

                    <div class="row">
                        <!-- 內容編輯器 -->
                        <div class="col-12">
                            <div class="form-group mb-3">
                                <label for="editor" class="control-label">內容 <small class="text-muted">(上限1000個字)</small></label>
                                @Html.TextAreaFor(m => m.Content, new { @class = "form-control", id = "editor" })
                                @Html.ValidationMessageFor(model => model.Content, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div style="width:120px;">
                            <div class="d-flex flex-column gap-2">
                                <button type="submit" class="btn btn-primary">送 出</button>
                            </div>
                        </div>
                        <div style="width:120px;">
                            <div class="d-flex flex-column gap-2">
                                <a class="btn btn-secondary" href="@Url.Action("Index", "Histories", new { area = "Back" })">返 回</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            if (typeof CKEDITOR !== 'undefined') {
                CKEDITOR.replace('editor', {
                    height: 500,
                    language: 'zh'
                });
            } else {
                console.error('CKEditor is not loaded!');
            }

            // 顯示成功訊息並跳轉
            @if (TempData["SuccessMessage"] != null)
            {
                <text>
                    setTimeout(function () {
                        alert("@TempData["SuccessMessage"]");
                        setTimeout(function () {
                            window.location.href = "@ViewBag.RedirectUrl";
                        }, 800); // 再延遲 0.8 秒跳轉
                    }, 500); // 先等 CKEditor 載完 0.5 秒
                </text>
            }

            // 顯示錯誤訊息
            @if (TempData["ErrorMessage"] != null)
            {
                <text>
                    alert("@TempData["ErrorMessage"]");
                </text>
            }
        });
    </script>
}
