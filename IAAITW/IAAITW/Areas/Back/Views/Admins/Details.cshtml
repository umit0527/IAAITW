@model IAAITW.Models.AdminEditViewModel

@{
    ViewBag.Title = "詳情 | 基本資料";
}

<div class="">
    <div class="row mb-4">
        <div class="col-12">
            <h3 class="font-weight-bold">基本資料</h3>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12 grid-margin stretch-card">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">詳 情</h4>
                    <hr />
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <!-- 帳 號 -->
                            <div class="mb-3">
                                <label class="form-label fw-bold">帳 號</label>
                                <div class="form-control text-secondary" style="background-color: #f8f9fa;">@Model.Account</div>
                            </div>

                            <!-- 姓 名 -->
                            <div class="mb-3">
                                <label class="form-label fw-bold">姓 名</label>
                                <div class="form-control text-secondary" style="background-color: #f8f9fa; ">
                                    @Model.Name
                                </div>
                            </div>

                            <!-- 電子郵件 -->
                            <div class="mb-3">
                                <label class="form-label fw-bold">Email</label>
                                <p class="form-control" style="background-color: #f8f9fa; ">
                                    <a href="mailto:@Model.Email">@Model.Email</a>
                                </p>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <!-- 建立日期 -->
                            <div class="mb-3">
                                <label class="form-label fw-bold">建立日期</label>
                                <p class="form-control-plaintext">@Model.CreatedDate.ToString("yyyy/MM/dd HH:mm")</p>
                            </div>

                            <!-- 最後更新時間 -->
                            <div class="mb-3">
                                <label class="form-label fw-bold">最後更新時間</label>
                                <p class="form-control-plaintext">@Model.UpdatedDate.ToString("yyyy/MM/dd HH:mm")</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 按鈕 -->
    <div class="row">
        <div style="width:120px;">
            <div class="d-flex flex-column gap-2">
                <a class="btn btn-primary" href="@Url.Action("Edit", "Admins", new { area = "Back",id=Model.Id })">編 輯</a>
            </div>
        </div>
    </div>
</div>