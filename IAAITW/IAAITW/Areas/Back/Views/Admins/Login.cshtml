@model IAAITW.Models.AdminLoginViewModel

@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="zh-Hant-TW">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>登入 - 後台</title>

    <!-- 使用 DashBoard 範本的 CSS（請確認路徑 /DashBoard/dist/assets 在專案中是可用的） -->
    <link rel="stylesheet" href="@Url.Content("~/DashBoard/dist/assets/vendors/css/vendor.bundle.base.css")" />
    <link rel="stylesheet" href="@Url.Content("~/DashBoard/dist/assets/vendors/font-awesome/css/font-awesome.min.css")" />
    <link rel="stylesheet" href="@Url.Content("~/DashBoard/dist/assets/css/style.css")" />
    <style>
        /* 小幅覆寫：置中 card、調整輸入寬度 */
        body {
            background: #f4f7fa;
        }

        .login-wrapper {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .login-card {
            max-width: 420px;
            width: 100%;
            padding: 2rem;
            border-radius: 8px;
            box-shadow: 0 6px 18px rgba(0,0,0,0.06);
            background: #fff;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 1.25rem;
        }

            .logo img {
                height: 40px;
            }

        .form-actions {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin-top: 1rem;
        }
    </style>
</head>

<body>
    <div class="login-wrapper">
        <div class="login-card">
            <div class="logo justify-content-center">
                <img src="@Url.Content("~/Back/images/logo.svg")" alt="logo" />
            </div>

            @using (Html.BeginForm("Login", "Admins", new { area = "Back" }, FormMethod.Post, new { @class = "mt-3" }))
            {
                @Html.AntiForgeryToken()
                <div class="form-group mb-3">
                    <label for="Account">帳號 / Email</label>
                    <input id="Account" name="Account" type="text" class="form-control" placeholder="請輸入帳號或 Email" required />
                </div>
                <div class="form-group mb-2">
                    <label for="Password">密碼</label>
                    <input id="Password" name="Password" type="password" class="form-control" placeholder="請輸入密碼" required />
                </div>

                <div class="form-actions justify-content-between">
                    <button type="submit" class="btn btn-primary" style="width:150px;">登 入</button>
                    <a class="btn btn-warning" href="@Url.Action("Register","Admins", new { area = "Back" })" style="width:150px;">註 冊</a>
                </div>

                @* 顯示伺服器端錯誤訊息（如果 Controller 有回傳 ModelState 或 ViewBag.Error） *@
                if (!ViewData.ModelState.IsValid)
                {
                    <div class="mt-3 text-danger">
                        帳號或密碼錯誤
                    </div>
                }
                else if (ViewBag.Error != null)
                {
                    <div class="mt-3 text-danger">@ViewBag.Error</div>
                }
            }

        </div>
    </div>

    <!-- JS（必要時可加入 vendor bundle / template js） -->
    <script src="@Url.Content("~/DashBoard/dist/assets/vendors/js/vendor.bundle.base.js")"></script>
    <script src="@Url.Content("~/DashBoard/dist/assets/js/template.js")"></script>

    <script>
        $(function () {

            // 專門處理錯誤圖示邏輯
            function updateValidationIcons() {
                $('span.field-validation-error').each(function () {
                    if (!$(this).find('i.fa-exclamation-circle').length) {
                        $(this).prepend('<i class="fa fa-exclamation-circle text-danger me-1"></i>');
                    }
                });
                $('span.field-validation-valid i.fa-exclamation-circle').remove();
            }

            // 初始載入檢查一次（避免第一次送出後不更新）
            updateValidationIcons();

            // 綁定輸入事件（keyup/change/blur 都觸發）
            $('form').on('keyup change blur', 'input, textarea, select', function () {
                updateValidationIcons();
            });

            // 綁定 jQuery Validate 的全域事件
            $('form').on('invalid-form.validate', function () {
                updateValidationIcons();
            });

            $('form').on('submit', function () {
                setTimeout(updateValidationIcons, 100); // 延遲讓驗證更新完再加 icon
            });
        });


       @* 通知訊息 *@
    $(document).ready(function () {
    // 顯示成功訊息並跳轉
    @if (TempData["SuccessMessage"] != null)
    {
        <text>
            setTimeout(function () {
                alert("@TempData["SuccessMessage"]");
                setTimeout(function () {
                    window.location.href = "@ViewBag.RedirectUrl";
                }, 800); // 再延遲 0.8 秒跳轉
            });
        </text>
    }

    // 顯示錯誤訊息
    @if (TempData["ErrorMessage"] != null)
    {
        <text>
        alert("@TempData["ErrorMessage"]");
        </text>
    }

        // 顯示登出訊息
@if (TempData["LogoutMessage"] != null)
{
    <text>
    alert("@TempData["LogoutMessage"]");
    </text>
}
});
    </script>
</body>
</html>