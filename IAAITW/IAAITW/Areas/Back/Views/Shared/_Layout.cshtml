<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - 後台</title>
    <!-- plugins:css -->
    <link rel="stylesheet" href="~/Back/vendors/feather/feather.css">
    <link rel="stylesheet" href="~/Back/vendors/ti-icons/css/themify-icons.css">
    <link rel="stylesheet" href="~/Back/vendors/css/vendor.bundle.base.css">
    <link rel="stylesheet" href="~/Back/vendors/font-awesome/css/font-awesome.min.css">
    <link rel="stylesheet" href="~/Back/vendors/mdi/css/materialdesignicons.min.css">
    <!-- endinject -->
    <!-- Plugin css for this page -->
    <!-- <link rel="stylesheet" href="~/back/vendors/datatables.net-bs4/dataTables.bootstrap4.css"> -->
    @*<link rel="stylesheet" href="~/Back/vendors/datatables.net-bs5/dataTables.bootstrap5.css">*@
    <link rel="stylesheet" href="~/Back/vendors/ti-icons/css/themify-icons.css">
    <link rel="stylesheet" type="text/css" href="~/Back/js/select.dataTables.min.css">
    <!-- End plugin css for this page -->
    <!-- inject:css -->
    <link rel="stylesheet" href="~/Back/css/style.css">

    @*<link rel="stylesheet" href="~/Back/js/dataTables.css">*@

    <!-- endinject -->
    <link rel="shortcut icon" href="~/Back/images/favicon.png" />
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")

</head>
<body>
    <div class="container-scroller">
        <!-- partial:partials/_navbar.html -->
        <nav class="navbar col-lg-12 col-12 p-0 fixed-top d-flex flex-row">
            <div class="text-center navbar-brand-wrapper d-flex align-items-center justify-content-start">
                <a class="navbar-brand brand-logo me-5" href="index.html"><img src="~/Back/images/logo.svg" class="me-2" alt="logo" /></a>
                <a class="navbar-brand brand-logo-mini" href="index.html"><img src="~/Back/images/logo-mini.svg" alt="logo" /></a>
            </div>
            <div class="navbar-menu-wrapper d-flex align-items-center justify-content-end">
                <button class="navbar-toggler navbar-toggler align-self-center" type="button" data-toggle="minimize">
                    <span class="icon-menu"></span>
                </button> 
            <ul class="navbar-nav navbar-nav-right">
                @{
                    var adminName = Session["AdminName"] as string;
                }
                @if (adminName != null)
                {
                    <li class="align-content-center">歡迎回來，@adminName</li>
                }
            </ul>
                <button class="navbar-toggler navbar-toggler-right d-lg-none align-self-center" type="button" data-toggle="offcanvas">
                    <span class="icon-menu"></span>
                </button>
            </div>
        </nav>
        <!-- partial -->
        <div class="container-fluid page-body-wrapper pt-0">
            <!-- partial:partials/_sidebar.html -->
            <nav class="sidebar sidebar-offcanvas mt-5" id="sidebar">
                <ul class="nav">

                    @* 關於我們 *@
                    <li class="nav-item">
                        <a class="nav-link" data-bs-toggle="collapse" href="#ui-basic" aria-expanded="false" aria-controls="ui-basic">
                            <i class="icon-layout menu-icon"></i>
                            <span class="menu-title">關於我們</span>
                            <i class="menu-arrow"></i>
                        </a>
                        <div class="collapse" id="ui-basic">
                            <ul class="nav flex-column sub-menu">
                                <li class="nav-item"> <a class="nav-link" href="@Url.Action("Index", "Abouts", new { area = "Back" })">關於我們</a></li>
                                <li class="nav-item"> <a class="nav-link" href="@Url.Action("Index", "Organizationes", new { area = "Back" })">組織架構</a></li>
                                <li class="nav-item"> <a class="nav-link" href="@Url.Action("Index", "Histories", new { area = "Back" })">沿革</a></li>
                                <li class="nav-item"> <a class="nav-link" href="@Url.Action("Index", "Experts", new { area = "Back" })">專家介紹</a></li>
                            </ul>
                        </div>
                    </li>

                    @* 訊息發布 *@
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "News", new { area = "Back" })">
                            <i class="mdi mdi-new-box menu-icon"></i>
                            <span class="menu-title">訊息發布</span>
                        </a>
                    </li>

                    @* 協會業務 *@
                    <li class="nav-item">
                        <a class="nav-link" data-bs-toggle="collapse" href="#charts" aria-expanded="false" aria-controls="charts">
                            <i class="icon-bar-graph menu-icon"></i>
                            <span class="menu-title">協會業務</span>
                            <i class="menu-arrow"></i>
                        </a>
                        <div class="collapse" id="charts">
                            <ul class="nav flex-column sub-menu">
                                <li class="nav-item"> <a class="nav-link" href="@Url.Action("Index", "Jobs", new { area = "Back" })">協會業務</a></li>
                                <li class="nav-item"> <a class="nav-link" href="@Url.Action("Index", "Lisences", new { area = "Back" })">訓練、認證、發照</a></li>
                                <li class="nav-item"> <a class="nav-link" href="@Url.Action("Index", "Refers", new { area = "Back" })">諮詢、顧問</a></li>
                                <li class="nav-item"> <a class="nav-link" href="@Url.Action("Index", "Surveys", new { area = "Back" })">縱火調查</a></li>
                            </ul>
                        </div>
                    </li>

                    @* 知識庫 *@
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "Knowledges", new { area = "Back" })">
                            <i class="mdi mdi-download menu-icon"></i>
                            <span class="menu-title">知識庫下載</span>
                        </a>
                    </li>

                    @* 行事曆 *@
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "Calendars", new { area = "Back" })">
                            <i class="mdi mdi-calendar menu-icon"></i>
                            <span class="menu-title">協會行事曆</span>
                        </a>
                    </li>

                    @* 聯絡我們 *@
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "Contact", new { area = "Back" })">
                            <i class="mdi mdi-email-outline menu-icon"></i>
                            <span class="menu-title">聯絡我們</span>
                        </a>
                    </li>

                    @* 會員專區 *@
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("Index", "Admins", new { area = "Back" })">
                        <i class="mdi mdi-account menu-icon"></i>
                        <span class="menu-title">會員資料</span>
                    </a>
                </li>

                    <li class="nav-item">
                        <hr />
                    </li>

                    @* 前台首頁 *@
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "Home", new { area = "Front" })" target="_blank">
                            <i class="mdi mdi-book-multiple menu-icon"></i>
                            <span class="menu-title">前台首頁</span>
                        </a>
                    </li>

                    @* 登出 *@
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Logout", "Admins", new { area = "Back" })">
                            <i class="mdi mdi-logout menu-icon"></i>
                            <span class="menu-title">登 出</span>
                        </a>
                    </li>
                </ul>
            </nav>
            <div class="main-panel mt-5">
                <div class="content-wrapper d-flex flex-column justify-content-between">

                    @RenderBody()

                </div>


                <footer id="footer" class="footer pb-3">
                    <hr />
                    <div class="container">

                        <div class="row copyright">
                            <div class="col-xs-12 col-sm-7">
                                <div class="copyright-info">
                                    <span>
                                        國際縱火調查人員協會臺灣分會版權所有<br>
                                        Copyright © 2016 International Association of Arson Investigators Taiwan Chapter. All Rights Reserved.
                                    </span>
                                </div>
                            </div>
                        </div>
                        <!-- Copyright end -->

                    </div>
                    <!--/ Container end -->
                </footer>
                <!-- Footer end -->
            </div>
        </div>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @Scripts.Render("~/bundles/jqueryval")
    @Scripts.Render("~/bundles/ckeditor")
    <!-- plugins:js -->
    <script src="~/Back/vendors/js/vendor.bundle.base.js"></script>
    <!-- endinject -->
    <!-- Plugin js for this page -->
    <script src="~/Back/vendors/chart.js/chart.umd.js"></script>
    @*<script src="~/Back/vendors/datatables.net/jquery.dataTables.js"></script>*@
    <!-- <script src="~/Back/vendors/datatables.net-bs4/dataTables.bootstrap4.js"></script> -->
    @*<script src="~/Back/vendors/datatables.net-bs5/dataTables.bootstrap5.js"></script>*@
    @*<script src="~/Back/js/dataTables.select.min.js"></script>*@
    <!-- End plugin js for this page -->
    <!-- inject:js -->
    <script src="~/Back/js/off-canvas.js"></script>
    <script src="~/Back/js/template.js"></script>
    <script src="~/Back/js/settings.js"></script>
    <script src="~/Back/js/todolist.js"></script>
    <!-- endinject -->
    <!-- Custom js for this page-->
    <script src="~/Back/js/jquery.cookie.js" type="text/javascript"></script>
    <script src="~/Back/js/dashboard.js"></script>
    <!-- <script src="~/Back/js/Chart.roundedBarCharts.js"></script> -->
    <style>
        .cke_notification_warning {
            display: none !important;
        }
    </style>

    @RenderSection("scripts", required: false)
</body>
</html>