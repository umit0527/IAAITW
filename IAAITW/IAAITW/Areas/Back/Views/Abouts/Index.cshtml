@model IEnumerable<IAAITW.Models.About>

@{
    ViewBag.Title = "關於我們";
    bool hasData = Model != null && Model.Any(); // 判斷是否已有資料
}

<div>
    <h2>關於我們</h2>

    @if (!hasData)
    {
        <p>
            @Html.ActionLink("新 增", "Create")
        </p>
    }
    <table class="table">
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Content)
            </th>
            <th>
                建立人員
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CreatedDate)
            </th>
            <th></th>
        </tr>

        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Admin.Account)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Content)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.CreatedDate)
                </td>
                <td>
                    @Html.ActionLink("編 輯", "Edit", new { id = item.Id }) |
                    @Html.ActionLink("詳 情", "Details", new { id = item.Id }) |
                    @Html.ActionLink("刪 除", "Delete", new { id = item.Id })
                </td>
            </tr>
        }

    </table>
</div>